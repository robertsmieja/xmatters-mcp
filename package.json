{
  "name": "@robertsmieja/xmatters-mcp",
  "version": "0.2.0",
  "description": "A comprehensive, safety-first xMatters REST API MCP server",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Robert Smieja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsmieja/xmatters-mcp.git"
  },
  "homepage": "https://github.com/robertsmieja/xmatters-mcp#readme",
  "bugs": {
    "url": "https://github.com/robertsmieja/xmatters-mcp/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "bin": {
    "xmatters-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/api-coverage.md",
    "docs/api-inventory.json",
    "docs/mcp-conformance.md",
    "docs/setup.md",
    "docs/configuration.md",
    "docs/tools.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:bun": "vitest run --project bun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:api": "node scripts/audit-api.mjs --offline",
    "audit:api:live": "node scripts/audit-api.mjs --live",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run test:integration",
    "start": "node dist/cli.js",
    "start:bun": "bun --no-env-file dist/cli.js",
    "dev:bun": "bun --no-env-file src/cli.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "xmatters",
    "mcp",
    "model-context-protocol",
    "on-call",
    "incident-management"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
