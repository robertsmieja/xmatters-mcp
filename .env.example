# Variable reference, not a working configuration. All credentials are placeholders.
# Supply secrets privately to the server process and the separate MCP host.
# Application code does not load .env files; Bun does unless you use --no-env-file.
XMATTERS_BASE_URL=https://example.xmatters.com
XMATTERS_API_KEY=x-api-key-REPLACE_WITH_COMPLETE_USERNAME
XMATTERS_API_SECRET=REPLACE_PRIVATELY
XMATTERS_ALLOW_WRITES=false
XMATTERS_TIMEOUT_MS=30000
XMATTERS_MAX_RESPONSE_BYTES=8388608
XMATTERS_MAX_UPLOAD_BYTES=8388608

# Separate local MCP access credential, never an xMatters credential.
# Generate privately: at least 32 random bytes as hex or base64url (no padding).
XMATTERS_MCP_TOKEN=REPLACE_PRIVATELY_WITH_RANDOM_LOCAL_TOKEN
XMATTERS_MCP_PORT=3000
XMATTERS_MCP_MAX_REQUEST_BYTES=16777216

# Choose exactly ONE auth mode. Remove API-key variables when using alternatives.
# Native Basic: XMATTERS_USERNAME + XMATTERS_PASSWORD
# Existing OAuth token: XMATTERS_ACCESS_TOKEN
# OAuth acquire: XMATTERS_CLIENT_ID + XMATTERS_USERNAME + XMATTERS_PASSWORD
# OAuth refresh: XMATTERS_CLIENT_ID + XMATTERS_REFRESH_TOKEN
